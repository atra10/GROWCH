; Engine configuration file.
; Open this folder in Godot 4.3 or newer (desktop or the Android editor).

config_version=5

[application]

config/name="The Terrible Knight"
config/description="A cursed werewolf becomes the Terrible Knight every full moon to rescue the princess."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.08, 1)
